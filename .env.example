# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional: Google Fonts Developer API Key (falls back to live Google Fonts directory metadata if omitted)
GOOGLE_FONTS_API_KEY=

# Optional: Deployed backend origin for standalone Tauri macOS .dmg builds (leave blank for web)
VITE_API_BASE_URL=

# Optional: Comma-separated extra web origins allowed to call /api/* via CORS (Tauri origins are always allowed)
ALLOWED_ORIGINS=


